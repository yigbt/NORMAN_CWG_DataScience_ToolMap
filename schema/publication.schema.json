{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication",
  "description": "Bibliographic record (metadata from Crossref).",
  "type": "object",
  "additionalProperties": false,
  "required": ["doi", "title", "year", "provenance"],
  "properties": {
    "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$", "maxLength": 200},
    "title": {"type": "string", "maxLength": 500},
    "authors": {"type": "string", "maxLength": 500},
    "journal": {"type": "string", "maxLength": 200},
    "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
    "provenance": {"$ref": "tool.schema.json#/$defs/provenance"}
  }
}
