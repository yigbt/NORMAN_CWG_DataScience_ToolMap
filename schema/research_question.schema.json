{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research question",
  "description": "A research question or cross-cutting topic on the WG roadmap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "category", "roadmap", "provenance"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 5, "maxLength": 160},
    "short_title": {"description": "Label for matrix columns and graph nodes.", "type": "string", "minLength": 2, "maxLength": 40},
    "description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "category": {"$vocab": "rq_categories"},
    "endpoint": {"$vocab": "endpoints"},
    "survey_demand": {
      "description": "Survey 2025: respondents naming this as urgent (Q8) and reporting own tools (Q6).",
      "type": "object", "additionalProperties": false,
      "properties": {
        "q8_need": {"type": "integer", "minimum": 0},
        "q6_have_tool": {"type": "integer", "minimum": 0},
        "q8_respondents": {"type": "integer", "minimum": 1}
      }
    },
    "roadmap": {
      "type": "object", "additionalProperties": false, "required": ["status", "priority"],
      "properties": {
        "status": {"$vocab": "roadmap_status"},
        "priority": {"$vocab": "priority"},
        "next_steps": {"type": "array", "items": {"type": "string", "maxLength": 300}},
        "lead": {"type": "string", "maxLength": 200},
        "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "notes": {"type": "string", "maxLength": 2000},
    "provenance": {"$ref": "tool.schema.json#/$defs/provenance"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80}}
}
