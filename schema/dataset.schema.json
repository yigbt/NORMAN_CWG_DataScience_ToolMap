{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset",
  "description": "A dataset offered for model development or validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "data_type", "access", "provenance"],
  "properties": {
    "id": {"$ref": "tool.schema.json#/$defs/id"},
    "name": {"type": "string", "minLength": 2, "maxLength": 160},
    "description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "data_type": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$vocab": "input_data"}},
    "matrices": {"type": "array", "uniqueItems": true, "items": {"$vocab": "matrices"}},
    "endpoints": {"type": "array", "uniqueItems": true, "items": {"$vocab": "endpoints"}},
    "research_questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "tool.schema.json#/$defs/id"}},
    "size": {"type": "string", "maxLength": 300},
    "labels": {"type": "string", "maxLength": 500},
    "access": {"type": "string", "enum": ["open", "on_request", "restricted"]},
    "url": {"$ref": "tool.schema.json#/$defs/url"},
    "contacts": {"$ref": "tool.schema.json#/properties/contacts"},
    "provenance": {"$ref": "tool.schema.json#/$defs/provenance"}
  }
}
