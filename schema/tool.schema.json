{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool",
  "description": "A data science / AI tool, model or resource relevant to emerging substances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "description", "endpoints", "maturity", "verification", "provenance"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "kind": {"$vocab": "kinds"},
    "description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "endpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$vocab": "endpoints"}},
    "research_questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "methods": {"type": "array", "uniqueItems": true, "items": {"$vocab": "methods"}},
    "input_data": {"type": "array", "uniqueItems": true, "items": {"$vocab": "input_data"}},
    "output": {"type": "string", "maxLength": 500},
    "availability": {"type": "array", "uniqueItems": true, "items": {"$vocab": "availability"}},
    "license": {"type": "string", "maxLength": 80},
    "url": {"$ref": "#/$defs/url"},
    "code_url": {"$ref": "#/$defs/url"},
    "publications": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/doi"}},
    "maturity": {"$vocab": "maturity"},
    "contacts": {
      "description": "Only with the consent of the person named.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {
          "name": {"type": "string", "maxLength": 120},
          "affiliation": {"type": "string", "maxLength": 200},
          "github": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"}
        }
      }
    },
    "verification": {"$vocab": "verification"},
    "notes": {"type": "string", "maxLength": 2000},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80},
    "url": {"type": "string", "pattern": "^https?://\\S+$", "maxLength": 500},
    "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$", "maxLength": 200},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "added"],
      "properties": {
        "source": {"type": "string", "maxLength": 120},
        "added": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "issue": {"type": "integer", "minimum": 1},
        "on_behalf_of": {"type": "string", "maxLength": 200}
      }
    }
  }
}
